# Server
NODE_ENV=development
PORT=3000
DATABASE_URL=
# Generate both with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
SERA_CONFIG_ENCRYPTION_KEY=

# Optional override. Defaults to http://localhost:3000 in development and https://pay.sera.cx in production.
PAYMENT_BASE_URL=

SERA_API_BASE_URL=https://api.sera.cx/api/v1
SERA_API_TESTNET_BASE_URL=https://api.testnet.sera.cx/api/v1

# Sera REST credentials are an "api_key:api_secret" PAIR — set the whole pair as
# one value, exactly as it is sent in `Authorization: Bearer {api_key}:{api_secret}`.
# Mint it with POST /api-keys (EIP-712 signed by the wallet that will own it) and
# verify it with POST /api-keys/verify. Required only for Sera's authenticated
# reads (GET /orders, /fills, /balances) — quotes, tokens and markets are public.
SERA_API_KEY=

# Sepolia master switch. Leave unset/false in production: when off, no request
# parameter, stale database row, or old QR code can route a payment to a test
# network. Sera supports only Ethereum mainnet and Sepolia.
SERA_ENABLE_TESTNET=false

GOLDSKY_GRAPHQL_URL=

# NOTE: there is no SERA_WEBHOOK_SECRET. Sera publishes no webhooks — the API is
# poll-only (docs.sera.cx FAQ: "Use polling with the REST API for order status
# updates"). The merchant-facing webhook SeraPay sends out is configured
# per-merchant in the dashboard, not here.

VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=
# Leave false for localhost unless your Privy client ID is allowed for local origins.
VITE_PRIVY_USE_CLIENT_ID_IN_DEV=false
PRIVY_SECRET=
PRIVY_JWKS=

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://sera.cx,https://www.sera.cx,https://app.sera.cx,https://dev.sera.cx,https://app.dev.sera.cx,https://testnet.sera.cx,https://app.testnet.sera.cx,https://pay.sera.cx,https://wallet.sera.cx

VITE_APP_BASE_URL=

# Client mirror of SERA_ENABLE_TESTNET. Keep false in production — it is what
# hides the "Sepolia Testnet" option in the network switcher.
# Never put a KEYED RPC url (Alchemy/Infura) in a VITE_ variable: every VITE_
# value is compiled into the browser bundle and is public to any visitor.
VITE_ENABLE_TESTNET=false

# Optional Cloudflare R2 object storage for merchant logos and menu images.
# Use server-only names for secrets. Do not prefix R2 credentials with VITE_.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_API_TOKEN=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_URL=
